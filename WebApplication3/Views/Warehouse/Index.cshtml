@model InventoryInvoiceApp.Models.WarehouseViewModel

@{
    ViewData["Title"] = "Warehouse";
}

<div class="warehouse-page">
    <div class="page-header">
        <div>
            <h1>Warehouse Supply</h1>

            <p>
                Register providers, materials and increase stock.
            </p>
        </div>

        <span>Warehouse</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-controller="Warehouse"
          asp-action="AddSupply"
          method="post"
          class="supply-form">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="form-grid">
            <div>
                <label asp-for="ProviderName"></label>

                <input asp-for="ProviderName"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="ProviderName"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="SupplyDate"></label>

                <input asp-for="SupplyDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="SupplyDate"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="MaterialName"></label>

                <input asp-for="MaterialName"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="MaterialName"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Quantity"></label>

                <input asp-for="Quantity"
                       type="number"
                       min="1"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Price"></label>

                <input asp-for="Price"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="add-button">
            Add Supply and Increase Stock
        </button>
    </form>

    <h2>Current Stock</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Serial</th>
                    <th>Provider</th>
                    <th>Material</th>
                    <th>Quantity</th>
                    <th>Price</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.CurrentStock)
                {
                    <tr>
                        <td>@item.SerialNumber</td>
                        <td>@item.ProviderName</td>
                        <td>@item.MaterialName</td>
                        <td>@item.Quantity</td>
                        <td>
                            @item.Price.ToString("0.00") JOD
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    body {
        background: #f3f7f5;
    }

    .warehouse-page {
        max-width: 1100px;
        margin: 35px auto;
        padding: 32px;
        border: 1px solid #dce7e1;
        border-radius: 16px;
        background: white;
        box-shadow: 0 10px 30px rgba(20, 80, 50, 0.08);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 20px;
        border-bottom: 1px solid #dfe9e4;
    }

        .page-header h1 {
            color: #24533c;
        }

        .page-header p {
            color: #728177;
        }

        .page-header > span {
            padding: 8px 14px;
            border-radius: 20px;
            background: #e1f5e8;
            color: #267548;
            font-weight: bold;
        }

    .supply-form {
        margin: 25px 0 35px;
        padding: 22px;
        border-radius: 12px;
        background: #f7faf8;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 16px;
    }

        .form-grid label {
            margin-bottom: 6px;
            color: #365947;
            font-weight: 600;
        }

    .add-button {
        margin-top: 20px;
        padding: 12px 20px;
        border: none;
        border-radius: 8px;
        background: #278451;
        color: white;
        font-weight: bold;
    }

    .warehouse-page h2 {
        color: #2e5441;
    }

    .text-danger {
        color: #b42318;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}