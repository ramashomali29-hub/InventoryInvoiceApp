@model List<InventoryInvoiceApp.Models.StockMovement>

@{
    ViewData["Title"] = "Stock Movements";
}

<div class="movements-page">
    <div class="movements-header">
        <div>
            <h1>Stock Movement History</h1>

            <p>
                Positive quantities are warehouse supplies.
                Negative quantities are cashier sales.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No stock movements have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Movement ID</th>
                        <th>Material</th>
                        <th>Quantity Change</th>
                        <th>Movement Type</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var movement in Model)
                    {
                        bool isIncrease =
                            movement.QuantityChange > 0;

                        <tr>
                            <td>@movement.Id</td>

                            <td>
                                @movement.MaterialName
                            </td>

                            <td>
                                <span class="@(isIncrease
                                                                        ? "increase-value"
                                                                        : "decrease-value")">

                                    @(isIncrease ? "+" : "")
                                    @movement.QuantityChange
                                </span>
                            </td>

                            <td>
                                @if (isIncrease)
                                {
                                    <span class="movement-badge increase">
                                        Warehouse Supply
                                    </span>
                                }
                                else
                                {
                                    <span class="movement-badge decrease">
                                        Cashier Sale
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    body {
        background: #f3f6fa;
    }

    .movements-page {
        max-width: 950px;
        margin: 35px auto;
        padding: 32px;
        border: 1px solid #dce3ed;
        border-radius: 16px;
        background: white;
        box-shadow: 0 10px 30px rgba(30, 50, 80, 0.08);
    }

    .movements-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e2e7ee;
    }

        .movements-header h1 {
            color: #263b5e;
        }

        .movements-header p {
            color: #6e7b90;
        }

    .increase-value {
        color: #168044;
        font-weight: bold;
    }

    .decrease-value {
        color: #c02c2c;
        font-weight: bold;
    }

    .movement-badge {
        padding: 6px 11px;
        border-radius: 20px;
        font-weight: 600;
    }

        .movement-badge.increase {
            background: #e3f7e9;
            color: #247646;
        }

        .movement-badge.decrease {
            background: #ffe6e6;
            color: #a72a2a;
        }
</style>