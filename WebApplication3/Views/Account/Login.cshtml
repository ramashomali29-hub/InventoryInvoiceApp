@model InventoryInvoiceApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-card">
    <div class="login-icon">I</div>

    <h1>Inventory Login</h1>

    <p>
        Enter your authorized account information.
    </p>

    <form asp-controller="Account"
          asp-action="Login"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="error-message"></div>

        <div class="form-group">
            <label asp-for="Email"></label>

            <input asp-for="Email"
                   class="form-control"
                   autocomplete="email"
                   placeholder="name@example.com" />

            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>

            <input asp-for="Password"
                   class="form-control"
                   autocomplete="current-password"
                   placeholder="Enter password" />

            <span asp-validation-for="Password"
                  class="text-danger"></span>
        </div>

        <label class="remember-option">
            <input asp-for="RememberMe" />
            Remember me
        </label>

        <button type="submit" class="login-button">
            Login
        </button>
    </form>
</div>

<style>
    body {
        background: #f2f5fa;
    }

    .login-card {
        max-width: 460px;
        margin: 60px auto;
        padding: 38px;
        border: 1px solid #dce3ed;
        border-radius: 17px;
        background: white;
        box-shadow: 0 12px 35px rgba(30, 50, 80, 0.1);
    }

    .login-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 16px;
        background: #315bd6;
        color: white;
        font-size: 34px;
        font-weight: bold;
    }

    .login-card h1 {
        margin-bottom: 6px;
        color: #263b5e;
        text-align: center;
    }

    .login-card > p {
        margin-bottom: 25px;
        color: #758196;
        text-align: center;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            color: #344866;
            font-weight: 600;
        }

    .form-control {
        width: 100%;
        padding: 11px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
    }

    .remember-option {
        display: flex;
        gap: 8px;
        color: #526176;
    }

    .login-button {
        width: 100%;
        margin-top: 20px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background: #315bd6;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

    .text-danger,
    .error-message {
        color: #b42318;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}